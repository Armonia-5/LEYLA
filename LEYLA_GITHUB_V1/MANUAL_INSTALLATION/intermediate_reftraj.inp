&GLOBAL
  PROJECT cha_MD 
  RUN_TYPE MD
  PRINT_LEVEL MEDIUM 
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    &LS_SCF
      EXTRAPOLATION_ORDER 3
    &END LS_SCF
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 280
      REL_CUTOFF 40
      NGRIDS 5
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      &OUTER_SCF
         EPS_SCF 1.0E-6
         MAX_SCF 10
      &END OUTER_SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF  50
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
        ENERGY_GAP 0.001
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &vdW_POTENTIAL
         DISPERSION_FUNCTIONAL PAIR_POTENTIAL
         &PAIR_POTENTIAL
            PARAMETER_FILE_NAME dftd3.dat
            TYPE DFTD3
            REFERENCE_FUNCTIONAL PBE
         &END PAIR_POTENTIAL
      &END vdW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 13.720 13.720 14.806 # Don't forget to adjust the cell parameters accordingly
      ALPHA_BETA_GAMMA 90.00 90.00 120.00 # Don't forget to adjust the cell parameters accordingly
    &END CELL
    &COORD
     @include 'coord.dat'
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
&MOTION
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
      &EACH
        MD 1
      &END EACH
    &END TRAJECTORY
    &VELOCITIES
      FORMAT XYZ
      &EACH
        MD 1
      &END EACH
    &END VELOCITIES
    &FORCES
      FORMAT XYZ
      &EACH
        MD 1
      &END EACH
      FILENAME forces
    &END FORCES
    &RESTART                                    ! This section controls the printing of restart files
      &EACH                                     ! A restart file will be printed every 10000 md steps
        MD 1
      &END
    &END
    &RESTART_HISTORY                            ! This section controls dumping of unique restart files during the run keeping all of them.Most useful if recovery is needed at a later point.
      &EACH                                     ! A new restart file will be printed every 10000 md steps
        MD 5000
      &END
    &END
  &END PRINT
  &MD
    ENSEMBLE REFTRAJ
    &REFTRAJ
      EVAL_ENERGY_FORCES T
      EVAL_FORCES T
      TRAJ_FILE_NAME selected_with_soap_final_bad_structure_remove.xyz
      FIRST_SNAPSHOT 1
      LAST_SNAPSHOT {{LAST_SNAPSHOT}}
      STRIDE 1
    &END REFTRAJ
    TIMESTEP [fs] 1.0
    TEMPERATURE 600
    &THERMOSTAT
      REGION GLOBAL
      TYPE CSVR
      &CSVR
        TIMECON [fs] 100
      &END CSVR
      &PRINT
        &TEMPERATURE
          &EACH
            MD 1
          &END EACH
        &END TEMPERATURE
      &END PRINT
    &END THERMOSTAT
  &END MD
&END MOTION


